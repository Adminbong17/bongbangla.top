# BongBangla Media Vault - .htaccess
# Place this in vault.bongbangla.top public_html root

# Increase upload limits for large videos
php_value upload_max_filesize 200M
php_value post_max_size 210M
php_value max_execution_time 300
php_value max_input_time 300
php_value memory_limit 256M

# Enable CORS for media files
<FilesMatch "\.(mp4|webm|mov|jpg|jpeg|png|gif|webp)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
    Header set Cache-Control "public, max-age=31536000"
</FilesMatch>

# Security: Block direct PHP execution in media folder (only allow media files)
<Directory "./media">
    php_flag engine off
    Options -Indexes
</Directory>

# Allow upload.php to run
<Files "upload.php">
    php_flag engine on
</Files>

# Redirect /api/upload to upload.php for compatibility with vault-config.js
RewriteEngine On
RewriteRule ^api/upload/?$ /upload.php [L,QSA]
